# Template 1 (paper) RSVP email. Required before that form can deliver mail.
RESEND_API_KEY=
RSVP_TO_EMAIL=
RSVP_FROM_EMAIL=Wedding RSVP <rsvp@your-verified-domain.com>

# Template 1 guest photo uploads. Presigned PUT to an S3-compatible bucket.
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Named by the original paper app. The upload route does not read this value.
S3_PUBLIC_BASE_URL=

# Named by the original sage app. No component reads this value.
# NEXT_PUBLIC_SITE_URL=https://wyvernstack.com
